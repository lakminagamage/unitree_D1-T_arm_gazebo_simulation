import os
from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import ExecuteProcess, TimerAction
from launch_ros.actions import Node

def generate_launch_description():
    pkg_path = get_package_share_directory('d1_550_description')
    urdf_path = os.path.join(pkg_path, 'urdf', 'd1_550_description.urdf')
    controllers_yaml = os.path.join(pkg_path, 'config', 'controllers.yaml')

    with open(urdf_path, 'r') as f:
        robot_description = f.read()

    # Fix mesh paths for Gazebo
    meshes_path = os.path.join(pkg_path, 'meshes')
    robot_description = robot_description.replace(
        'package://d1_550_description/meshes/',
        'file://' + meshes_path + '/'
    )

    # Fix $(find ...) in URDF for ros2
    robot_description = robot_description.replace(
        '$(find d1_550_description)/config/controllers.yaml',
        controllers_yaml
    )

    return LaunchDescription([
        # gzserver
        ExecuteProcess(
            cmd=['gzserver', '--verbose', '-s', 'libgazebo_ros_factory.so',
                 '-s', 'libgazebo_ros2_control.so'],
            output='screen'
        ),

        # gzclient after 3s
        TimerAction(period=3.0, actions=[
            ExecuteProcess(cmd=['gzclient'], output='screen')
        ]),

        # Robot state publisher
        Node(
            package='robot_state_publisher',
            executable='robot_state_publisher',
            parameters=[{'robot_description': robot_description}],
            output='screen'
        ),

        # Spawn arm after 6s
        TimerAction(period=6.0, actions=[
            Node(
                package='gazebo_ros',
                executable='spawn_entity.py',
                arguments=['-entity', 'd1_arm',
                           '-topic', '/robot_description',
                           '-x', '0.0', '-y', '0.0', '-z', '0.05'],
                output='screen'
            )
        ]),

        # Start controllers after arm spawns
        TimerAction(period=9.0, actions=[
            ExecuteProcess(
                cmd=['ros2', 'control', 'load_controller', '--set-state', 'start',
                     'joint_state_broadcaster'],
                output='screen'
            ),
        ]),
        TimerAction(period=10.0, actions=[
            ExecuteProcess(
                cmd=['ros2', 'control', 'load_controller', '--set-state', 'start',
                     'arm_controller'],
                output='screen'
            ),
            ExecuteProcess(
                cmd=['ros2', 'control', 'load_controller', '--set-state', 'start',
                     'gripper_controller'],
                output='screen'
            ),
        ]),

        # Joint State Publisher GUI — now talks to ros2_control
        TimerAction(period=11.0, actions=[
            Node(
                package='joint_state_publisher_gui',
                executable='joint_state_publisher_gui',
                output='screen',
            )
        ]),
    ])
